APP_ENV=local
AUTH_ENABLED=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:15433/rag_center
CELERY_BROKER_URL=redis://localhost:16379/0
CELERY_RESULT_BACKEND=redis://localhost:16379/1

# Langfuse retrieval observability. Set LANGFUSE_ENABLED=true after starting docker compose langfuse.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:13000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
# Must match the actual output dimension of EMBEDDING_MODEL.
EMBEDDING_DIMENSIONS=1536
# Maximum number of chunks sent in one Embedding request; the current model allows up to 20.
EMBEDDING_BATCH_SIZE=20

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
# custom 未显式指定改写时的默认值；命名 profile 的预设优先
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_TIMEOUT_MS=2000
QUERY_MAX_LENGTH=2000

VECTOR_STORE=pgvector
KEYWORD_SEARCH_PROVIDER=elasticsearch
ELASTICSEARCH_URL=http://localhost:19200
ELASTICSEARCH_INDEX=rag_chunks

RETRIEVAL_MODE=vector
HYBRID_FUSION=rrf
HYBRID_RRF_K=60
HYBRID_VECTOR_TOP_K=20
HYBRID_BM25_TOP_K=20
HYBRID_TOP_N=20

CHUNK_SIZE=800
CHUNK_OVERLAP=100
TABLE_MAX_ROWS_PER_CHUNK=10
TOP_K=5

DOCUMENT_STORAGE_PATH=./data/uploads
DOCUMENT_MAX_SIZE_MB=20

# custom 未显式指定时的默认值；命名 profile 的预设优先，套餐权限不受此设置影响
RERANK_ENABLED=false
# 可使用已开通模型的公共端点；专属业务空间亦可填入其 *.maas.aliyuncs.com/api/v1 地址
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_API_KEY=
RERANK_MODEL=qwen3.7-text-rerank
RERANK_TIMEOUT_SECONDS=15
RERANK_TOP_N=10

# 统一离线评测使用的本地租户 Key；切勿提交真实值
EVAL_API_KEY=
